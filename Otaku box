<body>
  <header>
    <div class="logo">OTAKU <span>BOX</span></div>
    <div>🍥</div>
  </header>

  <section class="hero">
    <div class="tag">YOUR ANIME UNIVERSE</div>
    <h1>Enter the<br>Anime World.</h1>
    <p>Discover anime, explore new worlds, and build your own watchlist.</p>
  </section>

  <input
    class="search"
    id="search"
    type="search"
    placeholder="🔎 Search anime..."
    aria-label="Search anime"
  >

  <h2 id="section-title">✨ Explore Anime</h2>

  <div class="anime-grid" id="anime-grid"></div>
  <p id="empty" hidden>No anime found.</p>

  <nav>
    <button onclick="showHome()">🏠 Home</button>
    <button onclick="showAnime()">🍥 Explore</button>
    <button onclick="showWatchlist()">💜 Watchlist</button>
  </nav>

  <footer>
    OTAKU BOX · Your anime journey starts here
  </footer>

  <script>
    const animeList = [
      { name: "Naruto", genre: "Action · Adventure", emoji: "🍥" },
      { name: "Demon Slayer", genre: "Action · Fantasy", emoji: "⚔️" },
      { name: "Solo Leveling", genre: "Action · Fantasy", emoji: "🌑" },
      { name: "Your Name", genre: "Romance · Fantasy", emoji: "🌌" },
      { name: "Haikyu!!", genre: "Sports · Comedy", emoji: "🏐" },
      { name: "Re:Zero", genre: "Fantasy · Drama", emoji: "⏳" }
    ];

    let currentView = "home";
    let searchText = "";
    let watchlist = JSON.parse(
      localStorage.getItem("otaku-watchlist") || "[]"
    );

    const grid = document.getElementById("anime-grid");
    const empty = document.getElementById("empty");
    const title = document.getElementById("section-title");

    function render() {
      const list = animeList.filter(anime => {
        const matchesSearch =
          anime.name.toLowerCase().includes(searchText.toLowerCase()) ||
          anime.genre.toLowerCase().includes(searchText.toLowerCase());

        const matchesView =
          currentView !== "watchlist" || watchlist.includes(anime.name);

        return matchesSearch && matchesView;
      });

      title.textContent =
        currentView === "watchlist" ? "💜 My Watchlist" : "✨ Explore Anime";

      grid.innerHTML = list.map(anime => {
        const saved = watchlist.includes(anime.name);

        return `
          <article class="anime">
            <div class="emoji">${anime.emoji}</div>
            <h3>${anime.name}</h3>
            <p>${anime.genre}</p>
            <button
              class="${saved ? "saved" : ""}"
              onclick="toggleWatchlist('${anime.name}')"
            >
              ${saved ? "✓ In Watchlist" : "+ Watchlist"}
            </button>
          </article>
        `;
      }).join("");

      empty.hidden = list.length > 0;
    }

    function toggleWatchlist(name) {
      watchlist = watchlist.includes(name)
        ? watchlist.filter(item => item !== name)
        : [...watchlist, name];

      localStorage.setItem(
        "otaku-watchlist",
        JSON.stringify(watchlist)
      );

      render();
    }

    function showHome() {
      currentView = "home";
      searchText = "";
      document.getElementById("search").value = "";
      render();
    }

    function showAnime() {
      currentView = "explore";
      render();
    }

    function showWatchlist() {
      currentView = "watchlist";
      render();
    }

    document.getElementById("search").addEventListener("input", event => {
      searchText = event.target.value;
      render();
    });

    render();
  </script>
</body>
</html>
